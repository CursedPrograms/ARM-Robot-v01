<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for every ARM controller UI (Python, web, C++, C#, Go, Rust, Julia).
  Edit a value and restart the controller - no rebuild needed. A missing or
  unreadable file/role falls back to the built-in default for that colour.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
  (Keep name before value; the C++, Rust and Julia loaders read it line by line.)

  Base palette (sampled from images/arm_avatar.jpg): silver #C0C4C7  |  steel #7C8390  |  gunmetal #3E4452  |  black #0A0A0F
  Text is white.
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"      value="#0A0A0F"/>  <!-- window / page background (dark) -->
  <colour name="panel"           value="#12121C"/>  <!-- cards, rows, list boxes -->
  <colour name="border"          value="#252537"/>

  <!-- Text -->
  <colour name="text"            value="#FFFFFF"/>
  <colour name="text_dim"        value="#949FA8"/>  <!-- status lines, sub-labels -->

  <!-- Buttons -->
  <colour name="button"          value="#252537"/>
  <colour name="button_hover"    value="#484E5B"/>
  <colour name="button_active"   value="#7C8390"/>  <!-- selected mode, pressed -->
  <colour name="button_disabled" value="#12121C"/>

  <!-- Accents -->
  <colour name="accent"          value="#C0C4C7"/>  <!-- prime colour: slider knob, highlights -->
  <colour name="accent_hover"    value="#E6E8EA"/>  <!-- lighter prime: values, connected dot -->
  <colour name="track"           value="#252537"/>  <!-- slider track -->
  <colour name="selected"        value="#3A3F4A"/>  <!-- selected macro row -->

  <!-- Alerts -->
  <colour name="danger"          value="#963232"/>  <!-- record / reset -->
  <colour name="danger_hover"    value="#AD3A3A"/>
  <colour name="warn"            value="#F08C3C"/>
</colour_scheme>
